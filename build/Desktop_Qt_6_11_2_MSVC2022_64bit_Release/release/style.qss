/* Blue Bear — dunkles, modernes Lila-Theme */

QMainWindow, QWidget#centralwidget {
	background-color: #0d0a16;
}

QWidget {
	color: #e5dffb;
	font-family: "Consolas";
	selection-background-color: #9333ea;
	selection-color: #ffffff;
}

/* --- Tab Widget --- */
QTabWidget::pane {
	border: 1px solid #241c3d;
	border-radius: 10px;
	background-color: #130f20;
	top: -1px;
}

QTabBar::tab {
	background-color: #18132a;
	color: #9686c4;
	padding: 8px 18px;
	margin-right: 4px;
	border-top-left-radius: 8px;
	border-top-right-radius: 8px;
	font-weight: bold;
}

QTabBar::tab:hover {
	background-color: #241c3d;
	color: #d6cdfb;
}

QTabBar::tab:selected {
	background-color: #130f20;
	color: #ffffff;
	border-bottom: 3px solid #9333ea;
}

/* --- Refresh-Button (neben den Tabs) --- */
QPushButton#refreshButton {
	background-color: #7c3aed;
	color: #ffffff;
	border: none;
	border-radius: 8px;
	padding: 6px 16px;
	font-weight: bold;
	margin: 2px 6px;
}

QPushButton#refreshButton:hover {
	background-color: #9333ea;
}

QPushButton#refreshButton:pressed {
	background-color: #6d28d9;
}

QPushButton#refreshButton:disabled {
	background-color: #2a2340;
	color: #716893;
}

/* --- Trees / Tables --- */
QTreeWidget, QTableWidget {
	background-color: #130f20;
	alternate-background-color: #18132a;
	border: 1px solid #241c3d;
	border-radius: 8px;
	gridline-color: #241c3d;
	outline: none;
}

QTreeWidget::item, QTableWidget::item {
	padding: 4px;
	border: none;
}

QTreeWidget::item:selected, QTableWidget::item:selected {
	background-color: #7c3aed;
	color: #ffffff;
	border-radius: 4px;
}

QTreeWidget::item:hover:!selected, QTableWidget::item:hover:!selected {
	background-color: #241c3d;
}

QHeaderView::section {
	background-color: #18132a;
	color: #c4b5fd;
	padding: 6px;
	border: none;
	border-bottom: 2px solid #7c3aed;
	font-weight: bold;
}

QHeaderView::section:hover {
	background-color: #241c3d;
}

/* --- Plain text edit --- */
QPlainTextEdit {
	background-color: #130f20;
	border: 1px solid #241c3d;
	border-radius: 8px;
	padding: 6px;
	color: #e5dffb;
}

/* --- Labels --- */
QLabel {
	color: #d6cdfb;
}

/* --- Scrollbars --- */
QScrollBar:vertical {
	background: #130f20;
	width: 10px;
	margin: 0;
}

QScrollBar::handle:vertical {
	background: #3d3159;
	border-radius: 5px;
	min-height: 24px;
}

QScrollBar::handle:vertical:hover {
	background: #7c3aed;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
	height: 0;
}

QScrollBar:horizontal {
	background: #130f20;
	height: 10px;
	margin: 0;
}

QScrollBar::handle:horizontal {
	background: #3d3159;
	border-radius: 5px;
	min-width: 24px;
}

QScrollBar::handle:horizontal:hover {
	background: #7c3aed;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
	width: 0;
}

/* --- Menu / Status bar --- */
QMenuBar {
	background-color: #0d0a16;
	color: #d6cdfb;
}

QMenuBar::item:selected {
	background-color: #241c3d;
	border-radius: 4px;
}

QStatusBar {
	background-color: #0d0a16;
	color: #9686c4;
}
