/* Blue Bear — modern purple dark theme */

QMainWindow, QWidget#centralwidget {
	background-color: #18141f;
}

QWidget {
	color: #e4defa;
	font-family: "Consolas";
	selection-background-color: #8b5cf6;
	selection-color: #ffffff;
}

/* --- Tab Widget --- */
QTabWidget::pane {
	border: 1px solid #332b4d;
	border-radius: 10px;
	background-color: #1f1a2e;
	top: -1px;
}

QTabBar::tab {
	background-color: #241e38;
	color: #ab9fd9;
	padding: 8px 18px;
	margin-right: 4px;
	border-top-left-radius: 8px;
	border-top-right-radius: 8px;
	font-weight: bold;
}

QTabBar::tab:hover {
	background-color: #322a4d;
	color: #d6cdfb;
}

QTabBar::tab:selected {
	background-color: #1f1a2e;
	color: #ffffff;
	border-bottom: 3px solid #a855f7;
}

/* --- Trees / Tables --- */
QTreeWidget, QTableWidget {
	background-color: #1f1a2e;
	alternate-background-color: #241e38;
	border: 1px solid #332b4d;
	border-radius: 8px;
	gridline-color: #332b4d;
	outline: none;
}

QTreeWidget::item, QTableWidget::item {
	padding: 4px;
	border: none;
}

QTreeWidget::item:selected, QTableWidget::item:selected {
	background-color: #7c3aed;
	color: #ffffff;
	border-radius: 4px;
}

QTreeWidget::item:hover:!selected, QTableWidget::item:hover:!selected {
	background-color: #322a4d;
}

QHeaderView::section {
	background-color: #241e38;
	color: #c4b5fd;
	padding: 6px;
	border: none;
	border-bottom: 2px solid #7c3aed;
	font-weight: bold;
}

QHeaderView::section:hover {
	background-color: #322a4d;
}

/* --- Plain text edit --- */
QPlainTextEdit {
	background-color: #1f1a2e;
	border: 1px solid #332b4d;
	border-radius: 8px;
	padding: 6px;
	color: #e4defa;
}

/* --- Labels --- */
QLabel {
	color: #d6cdfb;
}

/* --- Scrollbars --- */
QScrollBar:vertical {
	background: #1f1a2e;
	width: 10px;
	margin: 0;
}

QScrollBar::handle:vertical {
	background: #4c3d73;
	border-radius: 5px;
	min-height: 24px;
}

QScrollBar::handle:vertical:hover {
	background: #7c3aed;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
	height: 0;
}

QScrollBar:horizontal {
	background: #1f1a2e;
	height: 10px;
	margin: 0;
}

QScrollBar::handle:horizontal {
	background: #4c3d73;
	border-radius: 5px;
	min-width: 24px;
}

QScrollBar::handle:horizontal:hover {
	background: #7c3aed;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
	width: 0;
}

/* --- Menu / Status bar --- */
QMenuBar {
	background-color: #18141f;
	color: #d6cdfb;
}

QMenuBar::item:selected {
	background-color: #322a4d;
	border-radius: 4px;
}

QStatusBar {
	background-color: #18141f;
	color: #ab9fd9;
}
